{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "gitblocks-one.vercel.app"
        }
      ],
      "destination": "https://git.redstone.university/:path*",
      "permanent": true
    }
  ]
}
